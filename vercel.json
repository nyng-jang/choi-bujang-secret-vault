{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/notes.js": { "includeFiles": "aleph.config.json" },
    "api/session.js": { "includeFiles": "aleph.config.json" },
    "api/restore.js": { "includeFiles": "aleph.config.json" },
    "api/device.js": { "includeFiles": "aleph.config.json" }
  },
  "rewrites": [
    { "source": "/api/notes/:id/restore", "destination": "/api/restore?id=:id" },
    { "source": "/api/notes/:id", "destination": "/api/notes?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
